# Copy this file to .env in the repo root and fill in the values you have.
# .env is gitignored -- never commit real values.
#
# No key here unlocks the free analyses (scoring, bootstrap CIs, failure
# taxonomies, contamination tables) -- those run entirely from the cached
# results already checked into results/ and the small caches this repo
# includes. Keys below are only needed to RE-RUN generation (new embeddings,
# new judge/grader/solver calls) against live APIs.

# Google Gemini API -- unlocks: gemini-embedding-001 embeddings,
# gemini-3.1-flash-lite reranker judge, gemini-3-flash-preview RAG grader.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepInfra API -- unlocks: Qwen3-Embedding-8B (DeepInfra-hosted) embeddings,
# the DeepInfra-hosted solver comparison. Get one at https://deepinfra.com
DEEPINFRA_API_KEY=

# DeepSeek native API (api.deepseek.com, NOT DeepInfra's DeepSeek checkpoint)
# -- unlocks: deepseek-v4-flash as the utility-curve solver. Get one at
# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic API -- unlocks: claude-haiku-4-5 as the third reranker judge
# (math + trajectory domains, scripts/task2_haiku_reranker_full.py).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Internal MIT CSAIL lab infrastructure -- NOT PUBLICLY AVAILABLE ---
# These two point to private, campus-network-only lab hosts used for a subset
# of this project's results (the second Qwen3-Embedding-8B deployment
# comparison, §4 "deployment divergence"; and glm-5.2-fp8 as the second
# reranker judge / RAG grader B). There is no public equivalent to substitute
# -- results depending on these two are not independently re-runnable outside
# the lab. See README.md's reproduction table for exactly which results that
# affects; everything else in this repo does not depend on either variable.
MANTIS_EMBEDDINGS_BASE_URL=
MANTIS_LLM_BASE_URL=
